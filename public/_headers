# Netlify response headers (copied to dist/ by Vite). Rules are matched by URL
# path and every matching rule applies, so each Cache-Control below sits on a
# path set that no other Cache-Control rule matches.

# Vite's content-hashed output: JS (incl. the field engine + worker), CSS, fonts.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed public/ files: cache for a day, revalidate in the background for a week.
/textures/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/screenshots/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/photos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og-image.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon-16.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon-32.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Prerendered HTML (/, /work/<slug>, 404): always revalidate so a deploy shows at once
# (it names the new hashed assets).
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/work/*
  Cache-Control: public, max-age=0, must-revalidate
/404.html
  Cache-Control: public, max-age=0, must-revalidate

# Every response.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
